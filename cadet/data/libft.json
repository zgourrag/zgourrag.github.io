 "questions": [
  {
   "id": "q-void-size",
   "q": "What is the size of `void *` on a 64-bit system?",
   "options": [
    "4 bytes",
    "8 bytes",
    "16 bytes",
    "It depends on what it points to"
   ],
   "answer": 1,
   "explain": "Every data pointer is one machine word on a 64-bit system: 8 bytes."
  },
  {
   "id": "q-strdup-size",
   "q": "Which call reserves room for a copy of the string s?",
   "options": [
    "malloc(ft_strlen(s))",
    "malloc(ft_strlen(s) + 1)",
    "malloc(sizeof(s))",
    "malloc(sizeof(char *))"
   ],
   "answer": 1,
   "explain": "You need one extra byte for the terminating '\\0'. sizeof(s) is only the pointer size."
  },
  {
   "id": "q-after-free",
   "q": "After free(p); what does p contain?",
   "options": [
    "NULL",
    "The old address (dangling)",
    "0xDEADBEEF",
    "Whatever the OS decides"
   ],
   "answer": 1,
   "explain": "free does not change p. It still holds the old address, so set it to NULL yourself."
  }
 ],
 "boss": {
  "name": "The Mouinette",
  "alias": "The Void Pointer",
  "xp": 100,
  "timeLimitMs": 60000,
  "wrongPenaltyMs": 5000,
  "intro": "The Mouinette studies your code. Find the line that segfaults before time runs out.",
  "snippets": [
   {
